{
  "name": "scratch-desktop",
  "productName": "Scratch",
  "description": "Scratch 3.0 as a self-contained desktop application",
  "author": "Scratch Foundation",
  "version": "3.32.0",
  "license": "AGPL-3.0-only",
  "main": "./dist/main/main.js",
  "scripts": {
    "clean": "rimraf ./dist",
    "clean:fetched": "rimraf ./static/fetched",
    "start": "node scripts/start.js",
    "compile:renderer": "webpack --config webpack.renderer.js",
    "compile:main": "webpack --config webpack.main.js",
    "prepare-electron": "node -e \"require('electron')\"",
    "compile": "npm run prepare-electron && run-p compile:renderer compile:main",
    "fetch": "node ./scripts/fetchMediaLibraryAssets.js",
    "build": "npm run build:dev",
    "build:dev": "cross-env NODE_ENV=production npm run compile && npm run doBuild -- --mode=dev",
    "build:dir": "cross-env NODE_ENV=production npm run compile && npm run doBuild -- --mode=dir",
    "build:dist": "cross-env NODE_ENV=production npm run compile && npm run doBuild -- --mode=dist",
    "doBuild": "node ./scripts/electron-builder-wrapper.js",
    "dist": "npm run clean && npm run fetch && npm run build:dist --",
    "distDev": "npm run clean && npm run fetch && npm run build:dev --",
    "test": "npm run test:lint",
    "test:lint": "eslint --cache --color ."
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/scratchfoundation/scratch-desktop.git"
  },
  "dependencies": {
    "source-map-support": "0.5.19"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-proposal-object-rest-spread": "7.20.7",
    "@babel/plugin-syntax-dynamic-import": "7.8.3",
    "@babel/plugin-transform-async-to-generator": "7.29.7",
    "@babel/plugin-transform-nullish-coalescing-operator": "7.29.7",
    "@babel/plugin-transform-optional-chaining": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "@scratch/scratch-gui": "13.7.4-svg",
    "async": "3.2.6",
    "autoprefixer": "10.5.4",
    "babel-eslint": "10.1.0",
    "babel-loader": "9.2.1",
    "babel-plugin-react-intl": "7.9.4",
    "chalk": "4.1.2",
    "copy-webpack-plugin": "6.4.1",
    "cross-env": "7.0.3",
    "css-loader": "5.2.7",
    "electron": "42.9.0",
    "electron-builder": "26.15.3",
    "electron-devtools-installer": "4.0.0",
    "electron-store": "11.0.2",
    "eslint": "9.39.5",
    "eslint-config-scratch": "14.1.59",
    "fs-extra": "9.1.0",
    "html-loader": "0.5.5",
    "html-webpack-plugin": "5.6.8",
    "intl": "1.2.5",
    "lodash.bindall": "4.4.0",
    "lodash.defaultsdeep": "4.6.1",
    "lodash.omit": "4.18.0",
    "mini-css-extract-plugin": "1.6.2",
    "minilog": "3.1.0",
    "minimist": "1.2.8",
    "npm-run-all2": "8.0.4",
    "postcss-import": "12.0.1",
    "postcss-loader": "4.3.0",
    "postcss-simple-vars": "5.0.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-intl": "6.8.9",
    "react-redux": "8.1.3",
    "redux": "4.2.1",
    "rimraf": "3.0.2",
    "style-loader": "4.0.0",
    "url-loader": "4.1.1",
    "uuid": "8.3.2",
    "wait-on": "8.0.5",
    "webpack": "5.107.0",
    "webpack-cli": "5.1.4",
    "webpack-dev-server": "5.2.6",
    "webpack-merge": "4.2.2"
  },
  "resolutions": {
    "upath": "1.2.0"
  }
}
